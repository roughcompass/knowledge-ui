# Loaded by `vite dev` only (mode=development), for all three apps — each vite
# config sets `envDir` to this directory so one file serves the whole workspace.
#
# That is also why this is the *only* env file. Each app used to carry its own
# byte-identical copy setting the two variables below, and none of the three was
# ever read: `envDir` points here, so Vite never looked in the app directories.
# The settings happened to match the code's fallbacks, so nothing misbehaved and
# nothing revealed that the files were inert. They are now here, where they load.
#
# A production build loads none of this, which is correct — the persona switcher
# is disabled there and never reads it.

# Nothing here is a real credential: the local mock identity provider accepts any
# client_id/secret pair, so this value only has to be present. It lives in a file
# rather than as a literal in the persona roster because a literal survives
# tree-shaking inside `dist/**.map` via sourcesContent, and a published sourcemap
# is a published file. `check-no-dev-secrets` asserts it never reaches a build.
VITE_PERSONA_SECRET=dev-secret

# Empty means "same origin", which is what makes the dev proxy work. The API
# publishes no CORS headers, so a cross-origin absolute URL would fail at the
# preflight. Every request the app makes is relative.
VITE_API_BASE_URL=

# The persona switcher is a development affordance and carries dev client
# secrets, so it is off unless explicitly enabled. Redundant in `vite dev`, where
# the build-time DEV flag already enables it; stated because the flag is what
# enables it in the production-mode build the mocked end-to-end lane uses.
VITE_PERSONA_SWITCHER=on
