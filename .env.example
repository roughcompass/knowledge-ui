# Every variable this repo reads, and what happens when you leave it alone.
#
# `.gitignore` has called this file "the tracked spec" since it was written, and
# the file did not exist — so the one place that promised to list these was a
# promise. Nothing here is loaded: `.env.development` is what `vite dev` reads
# (all three apps point `envDir` at the repo root). Copy a line out of here into
# `.env` only when you need to override the default.
#
# Two families. `VITE_*` are read by the browser bundle and are baked in at build
# time, so anything here reaches the client. `KUI_*` are read by Node — the dev
# proxy, the build script and the seed scripts — and never ship.

# --- Browser: read at build time, present in the bundle ----------------------

# Where the app sends API requests. Empty means same origin, which is what makes
# the dev proxy work: the registry publishes no CORS headers, so a cross-origin
# absolute URL fails at the preflight before the app sees a response. The code
# defaults to empty, so leaving this unset is the same as setting it empty.
VITE_API_BASE_URL=

# Shows the development persona switcher. Redundant in `vite dev`, where the
# build-time DEV flag already enables it; it exists for the production-mode build
# the mocked end-to-end lane uses. Off anywhere else, because the roster it opens
# carries development client credentials.
VITE_PERSONA_SWITCHER=off

# The shared secret the persona switcher mints tokens with. Not a real
# credential — the local mock identity provider accepts any client_id/secret
# pair, so it only has to be present. Kept in a file rather than as a literal in
# the roster because a literal survives tree-shaking into `dist/**.map` via
# sourcesContent, and a published sourcemap is a published file.
VITE_PERSONA_SECRET=

# Compiles the request mocks into the bundle, so the app runs with no backend at
# all. Set by `build:e2e`; you almost never set it by hand.
VITE_MSW=off

# Base path the shell is served under, when it is not the domain root. Read by
# the build; the router resolves its basename from the served HTML at runtime, so
# the same artefact works at more than one path.
VITE_PUBLIC_PATH=/

# Origins the shell loads its remotes from. Defaults point at the local dev
# servers; `build:e2e` overrides them with the preview origins.
VITE_REMOTE_CATALOG=http://localhost:5171/remoteEntry.js
VITE_REMOTE_OPERATIONS=http://localhost:5172/remoteEntry.js

# --- Node: tooling only, never bundled ---------------------------------------

# What the dev and preview proxies forward to. Change these if your registry or
# identity provider is not on the default port.
KUI_API_TARGET=http://localhost:8000
KUI_IDP_TARGET=http://localhost:8090

# Builds the end-to-end artefacts against a real API instead of the request
# mocks, and selects the live Playwright project. Needs the three backing
# services running; run `npm run doctor` first.
KUI_LIVE=0

# The persona seed and verify scripts. The tenant slugs and the discriminator
# make up the entitlement grammar `<tenant_slug>_<DISCRIMINATOR>_<ROLE>`, which
# must match what the registry is configured to parse.
KUI_TENANT_SLUG=dev
KUI_SECOND_TENANT_SLUG=acme
KUI_DISCRIMINATOR=REGISTRY
KUI_IDP_URL=http://localhost:8090
KUI_ENTITLEMENT_URL=http://localhost:8091
KUI_API_URL=http://localhost:8000
