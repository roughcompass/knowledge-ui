{
  "name": "knowledge-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Salt Design System interface for the capability registry, built as a Module Federation 2 monorepo.",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "remotes/*"
  ],
  "scripts": {
    "dev": "concurrently -n shell,catalog,ops -c cyan,green,magenta \"npm:dev:shell\" \"npm:dev:catalog\" \"npm:dev:ops\"",
    "dev:shell": "npm run dev -w @knowledge-ui/shell",
    "dev:catalog": "npm run dev -w @knowledge-ui/remote-catalog",
    "dev:ops": "npm run dev -w @knowledge-ui/remote-operations",
    "dev:clean": "rimraf apps/*/node_modules/.vite remotes/*/node_modules/.vite node_modules/.vite",
    "build": "npm run build -w @knowledge-ui/remote-catalog && npm run build -w @knowledge-ui/remote-operations && npm run build -w @knowledge-ui/shell",
    "build:e2e": "node scripts/build-e2e.mjs",
    "preview:shell": "npm run preview -w @knowledge-ui/shell",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.module.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false && tsc -p apps/shell --pretty false && tsc -p remotes/catalog --pretty false && tsc -p remotes/operations --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "npm run codegen -w @knowledge-ui/api-client",
    "e2e": "playwright test",
    "e2e:dev": "playwright test -c playwright.dev.config.ts",
    "seed:personas": "node scripts/seed-personas.mjs",
    "verify:personas": "node scripts/verify-personas.mjs",
    "doctor": "npm run seed:personas && npm run verify:personas",
    "guards": "node scripts/check-no-doc-refs.mjs && node scripts/check-shared-parity.mjs",
    "ci": "npm run lint && npm run lint:css && npm run typecheck && npm run guards && npm run test && npm run build:e2e && node scripts/check-bundle-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.11.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "9.2.1",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.9",
    "vitest": "4.1.10"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.5"
  }
}
