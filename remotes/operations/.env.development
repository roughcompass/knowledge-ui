# Empty means "same origin", which is what makes the dev proxy work. The API
# publishes no CORS headers, so a cross-origin absolute URL would fail at the
# preflight. Every request the app makes is relative.
VITE_API_BASE_URL=
# The persona switcher is a development affordance and carries dev client
# secrets. It is off unless explicitly enabled.
VITE_PERSONA_SWITCHER=on
